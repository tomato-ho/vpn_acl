COMPOSE_PROJECT_NAME=vpn-acl

TZ=Asia/Shanghai

# 数据库（install.sh 会自动生成随机密码）
MARIADB_ROOT_PASSWORD=replace-with-strong-root-password
MARIADB_DATABASE=radius
MARIADB_USER=radius
MARIADB_PASSWORD=replace-with-strong-db-password
MARIADB_BIND=127.0.0.1
MARIADB_HOST_PORT=3306

# 可选：仅当启用 RADIUS accounting profile 时需要
#   podman-compose --profile radius up -d
RADIUS_SECRET=replace-with-strong-radius-secret

# 路径（一般不需要改）
VPN_CONFIG_DIR=/etc/vpn-policy
VPN_RUN_DIR=/run/vpn-policyd
VPN_OPENVPN_RUN_DIR=/run/openvpn-server
VPN_LOG_DIR=/var/log/vpn-policyd
VPN_CERTS_DIR=/etc/nginx/ssl
VPN_OPENVPN_CERTS=/etc/openvpn/server
VPN_WEB_ROOT=./vpn-admin/web/dist

# vpn-admin 在 compose 内部使用的监听地址（宿主侧只映射 127.0.0.1:8080）
# VPN_ADMIN_BIND=0.0.0.0